# Managed by Ansible (infra/ansible/roles/t3code). Manual edits will be overwritten.
[Unit]
Description=T3 Code server
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
User={{ t3code_user }}
Group={{ t3code_user }}
WorkingDirectory={{ t3code_home }}
ExecStart={{ t3code_npm_prefix }}/bin/t3 serve --host 127.0.0.1 --port {{ t3code_port }} --no-browser --tailscale-serve
Restart=on-failure
RestartSec=3
Environment=HOME={{ t3code_home }}
Environment=PATH={{ t3code_npm_prefix }}/bin:{{ t3code_home }}/.local/bin:/usr/local/bin:/usr/bin:/bin

[Install]
WantedBy=multi-user.target
